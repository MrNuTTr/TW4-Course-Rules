{
  "id": "kings4-entry",
  "cards": [
    {
      "type": "action",
      "title": "At Point Rusty",
      "mapFocus": [
        "(KNGP) Corpus Christi NAS/Rusty Departures/PT Rusty",
        "Kings 4 MOAs/Rusty Entry"
      ],
      "instructions": [
        "Turn right toward Bayside (~360°)",
        "Climb to 14,500 ft MSL",
        "Execute the area entry procedures"
      ],
      "source": "Binder, pp. 8–9; Feb 2026 PPT, Part 1, slide 57."
    },
    {
      "type": "radio",
      "title": "Hand-off to Houston Center",
      "mapFocus": "Kings 4 MOAs/Rusty Entry",
      "leadIn": "When directed by Corpus Departure:",
      "radio": {
        "channel": "Corpus Departure · UHF CH 6",
        "exchange": [
          {
            "speaker": "Departure",
            "text": "<callsign>, Corpus Departure, contact Houston Center on 135.05."
          },
          {
            "speaker": "Pilot",
            "text": "<callsign>, contact Houston Center on 135.05."
          }
        ]
      },
      "source": "Binder, p. 9."
    },
    {
      "type": "radio",
      "title": "Obtain KINGS 4 clearance",
      "mapFocus": "Kings 4 MOAs/Rusty Entry",
      "leadIn": "Before entering the MOA:",
      "radio": {
        "channel": "Houston Center · VHF CH 22",
        "exchange": [
          {
            "speaker": "Pilot",
            "text": "Houston Center, <callsign>, passing <altitude>, working KINGS 4."
          },
          {
            "speaker": "Houston Center",
            "text": "<callsign>, Houston Center, cleared KINGS 4 MOA."
          },
          {
            "speaker": "Pilot",
            "text": "<callsign>, cleared KINGS 4 MOA."
          }
        ]
      },
      "source": "Binder, p. 10."
    },
    {
      "type": "radio",
      "title": "Claim Area {to.area}",
      "mapFocus": "{to.area.moa}",
      "leadIn": "Before proceeding to the block:",
      "instructions": [
        "Wait for responses before claiming the area"
      ],
      "radio": {
        "channel": "KINGS 4 Common · UHF CH 20",
        "exchange": [
          {
            "speaker": "Pilot",
            "text": "99 KINGS 4, anybody working area {to.area.spoken}?"
          },
          {
            "speaker": "Pilot",
            "text": "99 KINGS 4, <callsign> claims area {to.area.spoken}."
          }
        ]
      },
      "source": "Binder, p. 10; Feb 2026 PPT, Part 1, slide 70."
    },
    {
      "type": "action",
      "title": "Enter KINGS 4",
      "mapFocus": "{to.area.moa}",
      "instructions": [
        "Do not enter the MOA until established at 14,500 ft MSL and cleared by Houston Center",
        "Enter via the transition layer",
        "{to.area.entryNote}"
      ],
      "source": "Binder, pp. 10–11; Feb 2026 PPT, Part 1, slides 70–71."
    },
    {
      "type": "action",
      "title": "Work Area {to.area}",
      "mapFocus": "{to.area.moa}",
      "instructions": [
        "Maintain a listening watch with Houston Center",
        "Use the ATC-supplied altimeter setting",
        "Block limits: {to.area.limits}; these are limits, not an assigned altitude"
      ],
      "source": "Binder, p. 11; Feb 2026 PPT, Part 1, slide 68."
    }
  ]
}
