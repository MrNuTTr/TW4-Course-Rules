{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start dev server",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Local:\\s+http://localhost:5173"
                }
            }
        }
    ]
}
